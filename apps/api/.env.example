APP_NAME=WeddingMap API
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DATABASE_URL=sqlite:///./weddingmap-local.db
APP_REDIS_URL=redis://localhost:6379/0
APP_JWT_SECRET=change-me-in-production
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_REFRESH_TOKEN_EXPIRE_MINUTES=10080
APP_ADMIN_AUTH_ENABLED=true
APP_ADMIN_SESSION_COOKIE_NAME=weddingmap_admin_session
APP_DATA_PORTAL_API_KEY=sample-data-portal-key
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
